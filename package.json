{
  "name": "@fasl-work/caos-app-shell",
  "version": "0.7.0",
  "description": "Shared web-app shell, workbench primitives, content primitives, design system and measured gate for the CAOS / Faena public apps (ADR-0016, ADR-0017, ADR-0071).",
  "license": "MIT",
  "author": "Felipe Santibáñez-Leal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsantibanezleal/CAOS_APP_SHELL.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "test:browser": "node --import tsx --test \"e2e/**/*.test.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "katex": "^0.16.0",
    "lucide-react": ">=0.400.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-router": "^6 || ^7 || ^8",
    "zustand": "^4 || ^5",
    "playwright": ">=1.40"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.1",
    "katex": "^0.16.11",
    "lucide-react": "1.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "bin": {
    "caos-shell-gate": "bin/caos-shell-gate.mjs"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
