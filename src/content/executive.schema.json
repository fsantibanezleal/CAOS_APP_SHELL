{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fsantibanezleal/CAOS_APP_SHELL/blob/main/src/content/executive.schema.json",
  "title": "CAOS executive view data, version 2.0.0",
  "description": "The one data file a CAOS product fills for the executive view of its Introduction (content/executive.json): the industry's problem framed for a decision maker, general and never tied to a client or written as a pitch. Every text is { en, es }; nothing outside these fields is allowed. The floors are minimum and maximum counts of rows (minItems, maxItems). The writing limits (30 words per sentence, one sentence for key messages, captions, actions and the like, two for the key statement, at least 25 words in a paragraph, no equation, no inline citation, no promotional or client-bound wording), the 4 C's rule (exactly the 4 C's of FOUR_CS, in order, each c equal to its name), the owners that are roles of the current situation, the weights of the causes and the sources-by-id rules (every citation names a source, every source is cited, a source is an https link whose title and note cite no file) are checked by validateExecutive in executive.ts, on top of this structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "key_statement",
    "headline_figures",
    "pain",
    "context",
    "situation",
    "trends",
    "proposal",
    "illustrations",
    "sources"
  ],
  "properties": {
    "title": {
      "$ref": "#/$defs/text",
      "description": "The problem's title: the industry's problem, not a product name."
    },
    "key_statement": {
      "$ref": "#/$defs/text",
      "description": "One or two sentences naming the pain and the direction proposed."
    },
    "headline_figures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "description": "Two or three headline figures, each a short heading, one figure and its linked source.",
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "pain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_message",
        "paragraphs",
        "bearers",
        "figures",
        "causes"
      ],
      "properties": {
        "key_message": {
          "$ref": "#/$defs/text",
          "description": "One line: what a reader who stops here takes away."
        },
        "paragraphs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "description": "Two paragraphs (at least 25 words each): what goes wrong, for whom, how big.",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "bearers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "who",
              "cost",
              "measure"
            ],
            "properties": {
              "who": {
                "$ref": "#/$defs/text",
                "description": "Who bears it."
              },
              "cost": {
                "$ref": "#/$defs/text",
                "description": "The cost in money, time, risk or harm."
              },
              "measure": {
                "$ref": "#/$defs/text",
                "description": "How it is measured."
              }
            }
          }
        },
        "figures": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "description": "At least two sourced industry figures.",
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "causes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "description": "Three to five non-overlapping branches, weighted by size.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cause",
              "weight"
            ],
            "properties": {
              "cause": {
                "$ref": "#/$defs/text",
                "description": "One branch of the problem; branches do not overlap."
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "The size of the branch as a percent of the whole; the weights add to at most 100."
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_message",
        "paragraphs",
        "setting",
        "forces",
        "evidence"
      ],
      "properties": {
        "key_message": {
          "$ref": "#/$defs/text",
          "description": "One line: what a reader who stops here takes away."
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "One or two paragraphs (at least 25 words each).",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "setting": {
          "$ref": "#/$defs/text",
          "description": "The class of organisations, rules, data and technology the problem lives in."
        },
        "forces": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "force",
              "direction"
            ],
            "properties": {
              "force": {
                "$ref": "#/$defs/text",
                "description": "A force that keeps the pain going."
              },
              "direction": {
                "$ref": "#/$defs/direction"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "At least one sourced rule or figure.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "source"
            ],
            "properties": {
              "statement": {
                "$ref": "#/$defs/text",
                "description": "One sourced rule or figure."
              },
              "source": {
                "$ref": "#/$defs/sourceId"
              }
            }
          }
        }
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_message",
        "roles",
        "interaction",
        "state_of_the_art",
        "status"
      ],
      "properties": {
        "key_message": {
          "$ref": "#/$defs/text",
          "description": "One line: what a reader who stops here takes away."
        },
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "decides",
              "needs"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/text",
                "description": "A role involved; a family of roles, never a person or an organisation."
              },
              "decides": {
                "$ref": "#/$defs/text",
                "description": "What it decides."
              },
              "needs": {
                "$ref": "#/$defs/text",
                "description": "What it needs."
              }
            }
          }
        },
        "interaction": {
          "$ref": "#/$defs/text",
          "description": "One sentence on how the roles interact."
        },
        "state_of_the_art": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approach",
              "achieves",
              "falls_short",
              "source"
            ],
            "properties": {
              "approach": {
                "$ref": "#/$defs/text",
                "description": "An approach in use, described fairly."
              },
              "achieves": {
                "$ref": "#/$defs/text",
                "description": "What it achieves."
              },
              "falls_short": {
                "$ref": "#/$defs/text",
                "description": "Where it falls short."
              },
              "source": {
                "$ref": "#/$defs/sourceId"
              }
            }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "value",
            "unit",
            "date",
            "source"
          ],
          "properties": {
            "heading": {
              "$ref": "#/$defs/text"
            },
            "value": {
              "$ref": "#/$defs/text"
            },
            "unit": {
              "$ref": "#/$defs/text"
            },
            "date": {
              "$ref": "#/$defs/text",
              "description": "The date of the figure."
            },
            "source": {
              "$ref": "#/$defs/sourceId"
            }
          },
          "description": "One sourced status figure with its date."
        }
      }
    },
    "trends": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_message",
        "items"
      ],
      "properties": {
        "key_message": {
          "$ref": "#/$defs/text",
          "description": "One line: what a reader who stops here takes away."
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trend",
              "kind",
              "direction",
              "horizon",
              "signal",
              "effect",
              "confidence"
            ],
            "properties": {
              "trend": {
                "$ref": "#/$defs/text"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "regulatory",
                  "technological",
                  "market",
                  "practice"
                ]
              },
              "direction": {
                "$ref": "#/$defs/direction"
              },
              "horizon": {
                "type": "string",
                "enum": [
                  "now",
                  "two_years",
                  "ten_years"
                ]
              },
              "signal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement",
                  "source"
                ],
                "properties": {
                  "statement": {
                    "$ref": "#/$defs/text",
                    "description": "The sourced signal."
                  },
                  "source": {
                    "$ref": "#/$defs/sourceId"
                  }
                }
              },
              "effect": {
                "$ref": "#/$defs/text",
                "description": "Its effect on the roles of the current situation."
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_message",
        "paragraphs",
        "four_cs",
        "actions",
        "risks",
        "unknowns"
      ],
      "properties": {
        "key_message": {
          "$ref": "#/$defs/text",
          "description": "One line: what a reader who stops here takes away."
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "The approach at the level of the problem, tied to its causes (at least 25 words each).",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "four_cs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "Required: exactly 4 rows, the 4 C's of FOUR_CS in order (Choice, Context, Cost, Control), each c equal to the name in both languages.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "c",
              "applies"
            ],
            "properties": {
              "c": {
                "$ref": "#/$defs/text",
                "description": "The C's name."
              },
              "applies": {
                "$ref": "#/$defs/text",
                "description": "One sentence: what this C means for the proposal."
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "owner",
              "horizon",
              "check"
            ],
            "properties": {
              "action": {
                "$ref": "#/$defs/text"
              },
              "owner": {
                "$ref": "#/$defs/text",
                "description": "A role of the current situation, written as there."
              },
              "horizon": {
                "$ref": "#/$defs/text"
              },
              "check": {
                "$ref": "#/$defs/text",
                "description": "How success is checked."
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "handoff": {
          "$ref": "#/$defs/text",
          "description": "Optional: one closing line on the part of the problem the work explores."
        }
      }
    },
    "illustrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pain",
        "situation",
        "proposal"
      ],
      "properties": {
        "pain": {
          "$ref": "#/$defs/illustration"
        },
        "situation": {
          "$ref": "#/$defs/illustration"
        },
        "proposal": {
          "$ref": "#/$defs/illustration"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "The sources, each a link; the notes are numbered in the order of first use. Every figure and every state-of-the-art or trend claim names one by id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "x-pattern-message": "must be lower case letters, digits and hyphens",
            "description": "The id the figures and claims cite."
          },
          "title": {
            "$ref": "#/$defs/text",
            "description": "The publication, in plain words."
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://[^\\s]+$",
            "x-pattern-message": "must be an https:// link (the page or document itself, no other scheme, no spaces)",
            "description": "The https link to the page or document."
          },
          "note": {
            "$ref": "#/$defs/text",
            "description": "Optional, at most one sentence, for example a page number. Never a file name or number."
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "description": "The id of an entry of sources."
    },
    "direction": {
      "type": "string",
      "enum": [
        "rising",
        "easing",
        "steady"
      ],
      "description": "Where the force or the trend is heading."
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "value",
        "unit",
        "source"
      ],
      "properties": {
        "heading": {
          "$ref": "#/$defs/text",
          "description": "A short heading."
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/sourceId"
        }
      }
    },
    "illustration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "caption"
      ],
      "properties": {
        "file": {
          "description": "The inline SVG: one path, or one path per language.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "en",
                "es"
              ],
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "es": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "caption": {
          "$ref": "#/$defs/text",
          "description": "One sentence saying what the reader should take from the illustration."
        }
      }
    }
  }
}
